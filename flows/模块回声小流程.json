{
  "name": "模块回声小流程",
  "nl_examples": [
    "被 Script.module 调用的子流程（Python 模块形态）",
    "模块回声：验证 Script.module 能调起子流程模块"
  ],
  "keywords": [
    "模块回声",
    "Script.module",
    "Python 模块"
  ],
  "params": [
    {
      "name": "out_dir",
      "type": "Str",
      "default": "${PROJECT_ROOT}/demo/_sub_out",
      "describe": "取证输出目录"
    },
    {
      "name": "echo_text",
      "type": "Str",
      "default": "MODULE-ECHO-OK",
      "describe": "主流程透传过来的文字；模块回声把它原样写进证据文件"
    }
  ],
  "nodes": [
    {
      "atom": "File.file_write",
      "alias": "模块把收到的参数写进文件（这是「参数真的传下来了」的证据）",
      "out": {
        "write_file_path": "echo_mark"
      },
      "inputs": {
        "file_path": [
          "$p:out_dir",
          "/模块回声.txt"
        ],
        "file_option": "create",
        "write_type": "overwrite",
        "msg": [
          "【模块已执行】收到主流程透传的 echo_text = ",
          "$p:echo_text",
          "\n如果这里的文字和主流程里填的不一样，说明 Script.process 没把参数传对。\n"
        ]
      }
    },
    {
      "atom": "File.file_write",
      "alias": "模块完成标记（这个文件出现 = 模块跑到了最后一步）",
      "out": {
        "write_file_path": "echo_done"
      },
      "inputs": {
        "file_path": [
          "$p:out_dir",
          "/模块回声_完成.txt"
        ],
        "file_option": "create",
        "write_type": "overwrite",
        "msg": [
          "模块执行完毕，echo_text = ",
          "$p:echo_text",
          "\n"
        ]
      }
    }
  ]
}