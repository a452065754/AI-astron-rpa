{
  "name": "文件夹批量复制小流程",
  "nl_examples": [
    "把这个目录下的子文件夹都复制到另一个地方",
    "批量备份整个文件夹",
    "把每个子文件夹拷一份到目标目录",
    "文件夹整体复制过去"
  ],
  "keywords": [
    "批量复制文件夹",
    "复制整个目录",
    "文件夹备份",
    "拷贝子文件夹"
  ],
  "params": [
    {
      "name": "in_dir",
      "type": "Str",
      "default": "F:\\AI-Workbench\\10-Projects\\星辰开源\\demo\\_folder_in",
      "describe": "源目录（只取它下面的第一层子文件夹）"
    },
    {
      "name": "out_dir",
      "type": "Str",
      "default": "F:\\AI-Workbench\\10-Projects\\星辰开源\\demo\\_folder_out",
      "describe": "目标目录（不存在会自动建）"
    }
  ],
  "nodes": [
    {
      "atom": "Folder.get_folder_list",
      "alias": "列出子文件夹",
      "out": {
        "folder_list": "folder_list"
      },
      "inputs": {
        "folder_path": "$p:in_dir",
        "traverse_subfolder": "no",
        "output_type": "list",
        "sort_method": "mtime",
        "sort_type": "ascending"
      }
    },
    {
      "atom": "Code.ForList",
      "alias": "逐个文件夹复制",
      "out": {
        "index": "idx",
        "item": "item"
      },
      "inputs": {
        "list": "$folder_list"
      }
    },
    {
      "atom": "Folder.folder_copy",
      "alias": "复制到目标目录",
      "out": {
        "copy_folder_path": "copied"
      },
      "inputs": {
        "source_path": "$item",
        "target_path": "$p:out_dir",
        "state_type": "create",
        "exist_options": "generate"
      }
    },
    {
      "atom": "Code.ForEnd",
      "alias": "循环结束",
      "out": {},
      "inputs": {}
    }
  ]
}
