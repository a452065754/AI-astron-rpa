{
  "name": "Word转PDF小流程",
  "nl_examples": [
    "把这个Word另存成PDF",
    "Word 转 PDF",
    "把 docx 导出成 pdf"
  ],
  "keywords": [
    "word转pdf",
    "docx转pdf",
    "转成pdf",
    "导出pdf",
    "另存pdf",
    "word转",
    "转pdf",
    "导出成pdf"
  ],
  "params": [
    {
      "name": "src_docx",
      "type": "Str",
      "default": "${PROJECT_ROOT}/demo/20260914报废_可编辑.docx",
      "describe": "源 Word 文件路径"
    },
    {
      "name": "out_dir",
      "type": "Str",
      "default": "${PROJECT_ROOT}/demo",
      "describe": "PDF 输出目录"
    },
    {
      "name": "out_name",
      "type": "Str",
      "default": "Word转PDF结果",
      "describe": "输出 PDF 文件名（不带 .pdf 后缀）"
    }
  ],
  "nodes": [
    {
      "atom": "Docx.open_docx",
      "alias": "打开源Word（不显示窗口）",
      "out": {
        "doc_obj": "doc"
      },
      "inputs": {
        "file_path": "$p:src_docx",
        "default_application": "Default",
        "visible_flag": false,
        "encoding": "utf-8",
        "open_pwd_flag": false,
        "open_pwd": "",
        "write_pwd_flag": false,
        "write_pwd": ""
      }
    },
    {
      "atom": "Docx.convert_format",
      "alias": "导出为PDF（全部页面）",
      "out": {},
      "inputs": {
        "doc": "$doc",
        "output_path": "$p:out_dir",
        "default_name": false,
        "output_name": "$p:out_name",
        "output_file_type": "pdf",
        "page_type": 0,
        "page_start": 1,
        "page_end": 1,
        "save_type": "overwrite"
      }
    },
    {
      "atom": "Docx.close_docx",
      "alias": "关闭Word（不保存改动）",
      "out": {},
      "on_error": "skip",
      "inputs": {
        "doc": "$doc",
        "close_range_flag": "one",
        "save_type": "abort",
        "file_path": "",
        "file_name": "",
        "exist_handle_type": "overwrite",
        "pkill_flag": false
      }
    }
  ]
}