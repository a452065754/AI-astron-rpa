{
  "name": "PDF抽取指定页小流程",
  "nl_examples": [
    "把这份PDF的第1到2页单独存一份",
    "只保留PDF的某几页",
    "PDF 抽页"
  ],
  "keywords": [
    "抽取",
    "抽页",
    "指定页",
    "只保留",
    "保留第",
    "提取页",
    "单独存"
  ],
  "params": [
    {
      "name": "src_pdf",
      "type": "Str",
      "default": "${PROJECT_ROOT}/demo/20260914报废_已转正.pdf",
      "describe": "源 PDF 文件路径"
    },
    {
      "name": "page_range",
      "type": "Str",
      "default": "1-2",
      "describe": "要保留的页码，格式如 1-3,5,7-9,11（表示 1~3 页、第 5 页、7~9 页、第 11 页）"
    },
    {
      "name": "out_dir",
      "type": "Str",
      "default": "${PROJECT_ROOT}/demo",
      "describe": "输出目录"
    },
    {
      "name": "out_name",
      "type": "Str",
      "default": "抽取结果",
      "describe": "输出文件名（不带 .pdf 后缀）"
    }
  ],
  "nodes": [
    {
      "atom": "PDF.extract_pdf_file",
      "alias": "按页码范围抽取",
      "out": {
        "extract_file_path": "extracted_path"
      },
      "inputs": {
        "file_path": "$p:src_pdf",
        "pwd": "",
        "page_range": "$p:page_range",
        "save_dir": "$p:out_dir",
        "new_file_name": "$p:out_name",
        "new_pwd_flag": false,
        "new_pwd": "",
        "exist_handle_type": "overwrite"
      }
    }
  ]
}