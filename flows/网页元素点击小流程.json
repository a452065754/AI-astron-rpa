{
  "name": "网页元素点击小流程",
  "nl_examples": [
    "打开网页点一下按钮",
    "在网页上点某个元素",
    "web 点击流程",
    "自动点搜索按钮"
  ],
  "keywords": [
    "网页",
    "浏览器",
    "点击",
    "按钮",
    "打开网站",
    "登录"
  ],
  "params": [
    {
      "name": "url",
      "type": "Str",
      "default": "https://www.baidu.com",
      "describe": "要打开的网页地址"
    }
  ],
  "element_requirements": [
    {
      "name": "百度_搜索按钮",
      "kind": "web",
      "pick": {
        "url": "https://www.baidu.com",
        "css": "#chat-submit-button"
      },
      "note": "百度首页的「百度一下」按钮。不能用 #su —— 那是隐藏旧节点（坑 125）"
    }
  ],
  "nodes": [
    {
      "atom": "BrowserSoftware.browser_open",
      "alias": "打开浏览器",
      "out": {
        "web_open": "web"
      },
      "inputs": {
        "url": "$p:url",
        "browser_type": "chrome",
        "timeout": 20,
        "timeout_handle_type": "execError",
        "wait_load_success": true,
        "open_with_incognito": false
      }
    },
    {
      "atom": "BrowserElement.click",
      "alias": "点击元素",
      "out": {},
      "inputs": {
        "browser_obj": "$web",
        "element_timeout": 10,
        "button_type": "click",
        "simulate_flag": true,
        "scroll_into_center": true
      },
      "elements": {
        "element_data": {
          "kind": "web",
          "name": "百度_搜索按钮"
        }
      }
    },
    {
      "atom": "BrowserSoftware.browser_close",
      "alias": "关闭浏览器",
      "out": {},
      "inputs": {
        "browser_obj": "$web"
      }
    }
  ]
}
