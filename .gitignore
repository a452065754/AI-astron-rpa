# ============ 本地配置（含 API Key / 服务器密码，绝不入库）============
rpa_config.json
rpa_config.local.json
*.secret.json
docs/_local_secrets.md
docs/backup/*.sql

# 换设备打包产物（scripts/handover_export.py 生成，内含明文凭据）
handover/

# ============ Python ============
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ============ 运行时缓存 / 自动生成产物（可重新生成，不入库）============
docs/atom_dict_cache.json
docs/element_cache.json
docs/generated_flow.json
docs/atom_coverage_report.json
docs/element-locator-map.json
docs/relocate-report.json

# 每次落库都会把旧的主流程快照存到这里（本地留档即可，不进仓库）
flows/_archive/

# ============ 平台环境专属的本地台账（**绝不能入库**）============
# scripts/module_ledger.json：脚本名 → 平台 moduleId（雪花号）。
# moduleId 是本环境专属的，换设备/换服务端全是废号；而且它只是「省一次建模块」的缓存，
# 丢了会自动重建（探活失败即重建），不需要版本化。
# 旧名 logs/script_modules.json 也留着规则，防老分支误提交。
logs/module_ledger.json
logs/script_modules.json
# logs/ 下的临时试验脚本/落盘日志一律不入库（跑完随手可删）
logs/_tmp_*
# nl2spec/ai_flow 的「录制包」与自测产物（每次跑都重新生成，可随时删）
logs/n2s_*/
logs/nl2spec_selftest*.json
logs/replay_*
logs/replay_out.json
# 内嵌脚本的本地落盘副本（由 resolve_scripts 从规格 scripts.code 生成，改它不生效）
scripts/mod_gen_*.py

# 复现包的中间产物（每次跑都重新生成，可随时整个删掉）
docs/repro/_tmp/

# 每次落库自动生成的评审单（带时间戳；同一流程反复跑会堆十几份，属噪音）
# 需要留档就单独挑几份，别整目录进仓库
docs/reviews/

# 流程跑动时新生成的测试数据（这些目录**从未入库**，堵住 git add . 的手滑）
demo/_archive_in/
demo/_organize_in/
demo/_split_out/
# 注意：demo/_excel_out、_merge_out、_word_out、_zip_out、_rename_in 等目录**已经被跟踪**，
# .gitignore 对已跟踪文件无效（它们仍会显示 M）。要彻底止噪得 `git rm --cached`，
# 但那些文件里混着流程的输入夹具，误删会连带改坏用例 —— 所以约定：
# **提交时不要 `git add demo/`**，只 add 明确路径。流程产出的变动留在工作区即可。

# 网页流程的截图存证产物（每次运行都会覆盖，不入库）
demo/_web_out/

# 本机运行产出的截图一律不入库：全屏截图会带桌面/其它窗口内容，属隐私
demo/_sys_out/*.png
demo/_sys_out/*.jpg
demo/_browser_out/*.png
demo/_browser_out/*.jpg
demo/_excel_out/*.png
demo/_code_out/*.png
demo/_probe/*.png

# 桌面/视觉靶场产出（2026-10-31 新增）：截图与浏览器 profile 一律不入库
#（全屏截图会带桌面/其它窗口内容，属隐私；profile 体积大且可再生），只留文本取证
demo/_cv_out/*.png
demo/_cv_out/*.jpg
demo/_gui_out/*.png
demo/_gui_out/*.jpg
demo/_cv_out/chrome-profile/
demo/_gui_out/chrome-profile*/
demo/_cv_out/site/
demo/_gui_out/site/

# 相似元素/OCR 试验的生成物（图片可再生；.txt 取证要入库）
demo/_ocr_out/*.png
demo/_similar_out/*.png

